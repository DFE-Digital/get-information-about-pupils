@model EditNewsArticleViewModel
@{
    ViewBag.Title = "Edit news article";
}

<div class="govuk-width-container">
    <partial name="Partials/Layout/_LayoutBackButton" model="@Model.BackButton" />

    <h1 class="govuk-heading-xl">Edit news article</h1>

    @if (Model?.NewsArticle != null)
    {
        <form method="post">
            <input type="hidden" asp-for="SelectedNewsId" />
            <input type="hidden" asp-for="NewsArticle.Id" />
            <input type="hidden" asp-for="NewsArticle.CreatedDate" />
            <input type="hidden" asp-for="NewsArticle.ModifiedDate" />

            <partial name="_NewsArticleFields" for="NewsArticle" />

            <div class="govuk-button-group">
                <govuk-button asp-controller="ManageNewsArticles" asp-action="UpdateNewsArticle" name="update" value="Update" type="submit">Update article</govuk-button>
                <govuk-button asp-controller="ManageNewsArticles" asp-action="DeleteNewsArticle" name="delete" value="Delete" type="submit" class="govuk-button--warning">Delete article</govuk-button>
            </div>
        </form>
    }
</div>
