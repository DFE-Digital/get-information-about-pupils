@model CreateNewsArticleViewModel
@{
    ViewBag.Title = "Create news article";
}

<div class="govuk-width-container">
    <partial name="Partials/Layout/_LayoutBackButton" model="@Model.BackButton" />

    <h1 class="govuk-heading-xl">Create news article</h1>

    <form method="post">
        <partial name="_NewsArticleFields" for="NewsArticle" />

        <div class="govuk-button-group">
            <govuk-button asp-controller="ManageNewsArticles" asp-action="CreateNewsArticle" id="CreateNewsArticle--button" name="Create">Save article</govuk-button>
            <govuk-button-link asp-controller="ManageNewsArticles" asp-action="ManageNewsArticles" id="discard-document--button" class="govuk-button--secondary">Discard</govuk-button-link>
        </div>
    </form>
</div>
