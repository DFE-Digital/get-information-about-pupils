@model LearnerNumberSearchViewModel

<form asp-action="@Model.SearchAction" method="POST">

    <input id="toggleSelectAll" type="hidden" name="ToggleSelectAll" value="@Model.ToggleSelectAll.ToString()" />
    <input id="@Model.LearnerNumber" name="LearnerNumber" type="hidden" value="@Model.LearnerNumber">
    <input type="hidden" id="LearnerIdSearchResult" name="LearnerIdSearchResult" value="@Model.LearnerIdSearchResult" />
    <input type="hidden" id="LearnerNumberIds" name="LearnerNumberIds" value="@Model.LearnerNumberIds" />

    @if (string.IsNullOrEmpty(Model.ErrorDetails) && Model.ItemAddedToMyPupilList && !Model.NoPupilSelected)
    {
        <govuk-inset-text>Pupil(s) added to your 'My pupils list'</govuk-inset-text>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorDetails) && Model.ErrorDetails.ToString().Equals(Messages.Downloads.Errors.UPNLimitExceeded))
    {
        <partial name="~/Views\Shared\_CTFLimitError.cshtml" />
    }

    @if (Model.Invalid.Any() || Model.Duplicates.Any() || Model.NotFound.Any())
    {
        <govuk-warning-text>
            One or more @(Model.LearnerNumberLabel)(s) have not been found or are duplicate. Only those @(Model.LearnerNumberLabel)(s) found will be shown.
        </govuk-warning-text>

        <noscript>
            @if (Model.ShowErrors)
            {
                <govuk-button class="govuk-button--secondary" type="submit" name="ShowErrors" value="false">Show valid @(Model.LearnerNumberLabel)s</govuk-button>
            }
            else
            {
                <govuk-button class="govuk-button--secondary" type="submit" name="ShowErrors" value="true">Show @(Model.LearnerNumberLabel)s not found, invalid or duplicate</govuk-button>
            }
        </noscript>

        <govuk-checkboxes name="toggleErrors" class="hide-for-non-js">
            <govuk-checkboxes-item value="true" id="toggleErrors">
                <span id="errors-show">Show @(Model.LearnerNumberLabel)s not found, invalid or duplicate</span>
            </govuk-checkboxes-item>
        </govuk-checkboxes>
    }

    @if (!Model.ShowErrors && (Model.Learners != null && Model.Learners.Any() && ViewData.ModelState.IsValid))
    {
        <govuk-inset-text>
            Please be aware that by selecting/de-selecting all pupils may take time to process
        </govuk-inset-text>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                @if (Model.ToggleSelectAll)
                {
                    <govuk-button asp-action="@Model.SearchAction" asp-route-pageNumber="@Model.PageNumber" class="govuk-button--secondary" type="submit" name="SelectAllNoJsChecked" value="false">Deselect all pupils</govuk-button>
                }
                else
                {
                    <govuk-button asp-action="@Model.SearchAction" asp-route-pageNumber="@Model.PageNumber" class="govuk-button--secondary" type="submit" name="SelectAllNoJsChecked" value="true">Select all pupils</govuk-button>
                }
            </div>

            <partial name="@Model.DownloadLinksPartial" />
        </div>
    }
    @if (Model.Invalid.Any() && Model.Learners.Any() && ViewData.ModelState.IsValid)
    {
        <partial name="~/Views/Shared/LearnerNumber/_ErrorTable.cshtml" model='new LearnerNumberErrorTableViewModel($"Invalid {Model.LearnerNumberLabel}s", Model.Invalid, "invalid", Model.ShowErrors)' />
    }

    @if (Model.NotFound.Any())
    {
        <partial name="~/Views/Shared/LearnerNumber/_ErrorTable.cshtml" model='new LearnerNumberErrorTableViewModel($"{Model.LearnerNumberLabel}s not found", Model.NotFound, "not-found", Model.ShowErrors)' />
    }

    @if (Model.Duplicates.Any())
    {
        <partial name="~/Views/Shared/LearnerNumber/_ErrorTable.cshtml" model='new LearnerNumberErrorTableViewModel($"Duplicate {Model.LearnerNumberLabel}s", Model.Duplicates, "duplicates", Model.ShowErrors)' />
    }

    @if (Model.Learners != null && Model.Learners.Any() && ViewData.ModelState.IsValid)
    {
        <div class="result-table @(Model.ShowErrors ? "hide-for-non-js" : "")">
            @(await Component.InvokeAsync("PaginatedResult", new
            {
                learners = Model.Learners,
                pageLearnerNumbers = Model.PageLearnerNumbers,
                learnerNumberLabel = Model.LearnerNumberLabel,
                showMiddleNames = Model.ShowMiddleNames,
                showNoSelectedError = Model.NoPupil,
                allowMultipleSelection = true,
                pageNumber = Model.PageNumber,
                pageSize = Model.PageSize,
                total = Model.Total,
                controllerAction = Model.SearchAction,
                showPP = false,
                showLocalAuthority = Model.ShowLocalAuthority,
                activeSortField = Model.SortField,
                activeSortDirection = Model.SortDirection
            }))
        </div>
    }
</form>
