@model LearnerNumberSearchViewModel

<h2 class="govuk-heading-m" id="search--heading">Search</h2>

<form method="POST">
    <input type="hidden" id="LearnerNumberLabel" name="LearnerNumberLabel" value="@Model.LearnerNumberLabel">

    <govuk-textarea for="LearnerNumber" id="search--textarea" rows="8" textarea-attributes="@(new Dictionary<string, object> { ["maxlength"] = 56014 })" ignore-model-state-errors="true">
        <govuk-textarea-label id="lbl-search-box">@($"Enter single, or multiple {Model.LearnerNumberLabel}s on separate lines.")</govuk-textarea-label>
        @if (!ViewData.ModelState.IsValid)
        {
            <govuk-textarea-error-message>@Model.SearchBoxErrorMessage</govuk-textarea-error-message>
        }
        <govuk-textarea-value>@Model.LearnerNumber</govuk-textarea-value>
    </govuk-textarea>
    <govuk-button asp-action="@Model.SearchAction" asp-route-reset="false" id="search--btn" value="Select" name="select">Search</govuk-button>

    <ul class="govuk-list">
        <li>
            <a class="govuk-link" id="link-search-again" asp-action="@Model.SearchAction" asp-route-reset="true"
               value="SearchAgain" name="searchAgain">Search again</a>
        </li>
        <li>
            <a class="govuk-link" id="search-searchwithout--link" asp-controller="@Model.FullTextLearnerSearchController" asp-action="@Model.FullTextLearnerSearchAction"
               value="SearchWithoutUpn" name="searchWithoutUpn">Search by name</a>
        </li>
    </ul>
</form>
