@model LearnerNumberSearchViewModel

<form method="POST">
    <input type="hidden" id="LearnerNumberLabel" name="LearnerNumberLabel" value="@Model.LearnerNumberLabel">

    <govuk-textarea for="LearnerNumber" id="search--textarea" rows="5" textarea-attributes="@(new Dictionary<string, object> { ["maxlength"] = 56014 })" ignore-model-state-errors="true">
        <govuk-textarea-label id="lbl-search-box">@($"Enter single, or multiple {Model.LearnerNumberLabel}s on separate lines.")</govuk-textarea-label>
        @if (!ViewData.ModelState.IsValid)
        {
            <govuk-textarea-error-message>@Model.SearchBoxErrorMessage</govuk-textarea-error-message>
        }
        <govuk-textarea-value>@Model.LearnerNumber</govuk-textarea-value>
    </govuk-textarea>

    <div class="govuk-button-group">
        <govuk-button type="submit" asp-action="@Model.SearchAction" asp-route-reset="true" id="search--btn" value="Select" name="select">
            Search
        </govuk-button>

        <a class="govuk-link" asp-controller="@Model.FullTextLearnerSearchController" asp-action="@Model.FullTextLearnerSearchAction"
           value="SearchWithoutUpn" name="searchWithoutUpn">Search by name</a>
    </div>
</form>
