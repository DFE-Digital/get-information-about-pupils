@model LearnerNumberSearchViewModel

@if (Model.LearnerNumber.Length > 0)
{
    <input type="hidden" name="ReturnLearnerNumbers" value="@Model.LearnerNumber" />
    <div class="govuk-grid-column-one-quarter">
        <govuk-button asp-action="DownloadCommonTransferFileData" name="downloadASCTF" value="selected" type="submit">
            @Model.DownloadSelectedASCTFLink
        </govuk-button>
    </div>
    <div class="govuk-grid-column-one-quarter">
        <govuk-button asp-action="ToDownloadSelectedNPDDataUPN" type="submit">
            @Model.DownloadSelectedLink
        </govuk-button>
    </div>
    <div class="govuk-grid-column-one-quarter">
        <govuk-button class="govuk-button--secondary" asp-action="NPDAddToMyPupilList" name="myPupilList" value="selected" type="submit">
            @Model.AddSelectedToMyPupilListLink
        </govuk-button>
    </div>
}
