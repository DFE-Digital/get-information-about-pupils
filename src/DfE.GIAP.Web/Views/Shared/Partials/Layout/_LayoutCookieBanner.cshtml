@inject DfE.GIAP.Web.Providers.Cookie.ICookieProvider CookieProvider
@{
    var bannerSeen = CookieProvider.Get(CookieKeys.GiapCookieBannerSeen);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@if (bannerSeen is null)
{
    <form asp-controller="Cookies" asp-action="CookieBanner" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <govuk-cookie-banner aria-label="Cookies on Get information about pupils">
            <message>
                <heading>Cookies on Get information about pupils</heading>
                <content>
                    <p class="govuk-body">We use some essential cookies to make this service work.</p>
                    <p class="govuk-body">We’d also like to use analytics cookies so we can understand how you use the service and make improvements.</p>
                </content>
                <message-actions>
                    <action-button text="Accept analytics cookies" type="submit" name="analytics" value="yes" />
                    <action-button text="Reject analytics cookies" type="submit" name="analytics" value="no" />
                    <action-link text="View cookies" asp-controller="Cookies" asp-action="Index" />
                </message-actions>
            </message>
        </govuk-cookie-banner>
    </form>
}
