@{
    Layout = "_GovUkPageTemplate";

    ViewData["Title"] = PageTitleFormatter.Format(
        ViewData["Title"],
        ViewData.ModelState.IsValid,
        Context.Request.Method == "POST");

    ViewData["HtmlClasses"] = "app-html-class";
    ViewData["BodyClasses"] = "app-body-class";
    ViewData["ContainerClasses"] = "app-width-container";
    ViewData["MainClasses"] = "app-main-class";
    ViewData["ThemeColor"] = "blue";
    ViewData["CspNonce"] = Context.Items["CSPNonce"] as string;
}

@section Head {
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    <partial name="Partials/Layout/_LayoutHeadAnalytics" />
}

@section BodyStart {
    <partial name="Partials/Layout/_LayoutBodyAnalytics" />
    <partial name="Partials/Layout/_LayoutCookieBanner" />
}

@section GovUkHeader {
    <partial name="Partials/Layout/_LayoutHeader" />
}

@section GovUkServiceNavigation {
    <partial name="Partials/Layout/_LayoutNavigation" />
}

@section HeaderEnd {
    <div class="govuk-width-container">
        <govuk-phase-banner>
            <tag>Beta</tag>
            Your <a class="govuk-link" href="https://forms.office.com/Pages/ResponsePage.aspx?id=yXfS-grGoU2187O4s0qC-QFBqGuEiypClSvu8k1WmbJUMllIMU5EOTFIUEpNM1c2NzhCUlZCQ0dSTyQlQCN0PWcu" target="_blank">feedback</a>
            will help us to improve our service.
        </govuk-phase-banner>
    </div>
}

@section BeforeContent {
    <partial name="Partials/Layout/_LayoutNewsBanner" />
}

@RenderBody()

@section GovUkFooter {
    <partial name="Partials/Layout/_LayoutFooter" />
}
