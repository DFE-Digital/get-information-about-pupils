@model DfE.GIAP.Web.ViewModels.BackButtonViewModel

@if (Model != null && Model.IsBackButtonEnabled)
{
    <div class="govuk-width-container">
        @if (Model.PreviousController != null && Model.PreviousAction != null)
        {
            <govuk-back-link asp-controller="@Model.PreviousController" asp-action="@Model.PreviousAction" id="back-link--link">Back</govuk-back-link>
        }
        else
        {
            <govuk-back-link asp-route-returnUrl="@ViewContext.HttpContext.Request.Path" id="back-link--link">Back</govuk-back-link>
        }
    </div>
}
