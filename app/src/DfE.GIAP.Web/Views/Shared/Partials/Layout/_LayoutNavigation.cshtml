@inject IAuthorizationService AuthorizationService
@using GovUk.Frontend.AspNetCore

<govuk-service-navigation service-name="Get information about pupils" service-url="/">
    <nav aria-label="Menu">
        <nav-item asp-controller="News" asp-action="Index">News</nav-item>

        @if (!User.IsOrganisationEstablishmentWithFurtherEducation())
        {
            <nav-item asp-controller="@Global.NPDLearnerNumberSearchController" asp-action="NationalPupilDatabase" link-id="header--search-npd--link">Search NPD</nav-item>
            <nav-item asp-controller="@Global.PPLearnerNumberSearchController" asp-action="PupilPremium" link-id="header--search-pp--link">Search pupil premium</nav-item>
        }

        @if (User.IsAdmin() ||
             User.IsOrganisationEstablishmentWithFurtherEducation() ||
             User.IsEstablishmentWithAccessToULNPages() ||
             User.IsDfeUser())
        {
            <nav-item asp-controller="@Global.FELearnerNumberSearchController" asp-action="PupilUlnSearch" link-id="header--search-uln--link">Search further education</nav-item>
        }

        @if (!User.IsOrganisationEstablishmentWithFurtherEducation())
        {
            <nav-item asp-controller="PreparedDownloads" asp-action="Index">Data downloads</nav-item>
            <nav-item asp-controller="GetMyPupils" asp-action="Index" link-id="header--mpl--link">My pupils</nav-item>
        }

        @{
            AuthorizationResult authResult = await AuthorizationService.AuthorizeAsync(User, Policy.RequiresManageContentAccess);
            if (authResult.Succeeded)
            {
                <nav-item asp-controller="Content" asp-action="Index">Content</nav-item>
            }
        }

        <nav-item asp-controller="Authentication" asp-action="SignoutDsi">Sign out</nav-item>
    </nav>
    <end align="ServiceNavigationEndSlotAlign.Inline">
        <span class="govuk-body-s app-header__user">@User.GetUserEmail()</span>
    </end>
</govuk-service-navigation>
