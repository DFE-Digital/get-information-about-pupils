@model NewsBannerViewModel

@if (Model.ShowBanner && Model.ConsentGiven)
{
    <govuk-notification-banner>
        <notification-banner-title>News</notification-banner-title>
        <p class="govuk-notification-banner__heading">The news section has updates.</p>
        <p class="govuk-body">
            <a asp-controller="News" asp-action="Index" class="govuk-notification-banner__link" id="news--banner-read--link">Read</a>
            <a asp-controller="News" asp-action="DismissNewsBanner" asp-route-returnUrl="@ViewContext.HttpContext.Request.Path" class="govuk-notification-banner__link govuk-!-margin-left-4" id="news--banner-dismiss--link">Dismiss</a>
        </p>
    </govuk-notification-banner>
}
